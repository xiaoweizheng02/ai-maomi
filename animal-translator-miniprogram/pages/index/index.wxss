.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #F5F5F5 0%, #E0E0E0 100%);
  padding: 64rpx 32rpx;
}

.header {
  width: 100%;
  max-width: 600rpx;
  text-align: center;
  margin-bottom: 64rpx;
}

.header-icon {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #212121;
  margin-bottom: 24rpx;
  display: block;
}

.subtitle {
  font-size: 26rpx;
  color: #757575;
  display: block;
}

.animal-cards {
  width: 100%;
  max-width: 600rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40rpx;
  margin-bottom: 40rpx;
}

.animal-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  border-radius: 32rpx;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 10rpx 25rpx -5rpx rgba(0, 0, 0, 0.1), 0 8rpx 10rpx -6rpx rgba(0, 0, 0, 0.1);
}

.animal-card:active {
  transform: scale(0.95);
}

.dog-card {
  background: linear-gradient(135deg, #4A90E2 0%, #2C6ED5 100%);
}

.cat-card {
  background: linear-gradient(135deg, #9B59B6 0%, #7D3C98 100%);
}

.paw-icon {
  font-size: 160rpx;
  margin-bottom: 40rpx;
}

.animal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 20rpx;
}

.animal-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
}

.recording-indicator {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 32rpx;
  z-index: 10;
}

.recording-animation {
  width: 160rpx;
  height: 160rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.3);
  border-top: 10rpx solid white;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.translation-box {
  width: 100%;
  max-width: 600rpx;
  background-color: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 25rpx -5rpx rgba(0, 0, 0, 0.1), 0 8rpx 10rpx -6rpx rgba(0, 0, 0, 0.1);
  margin-top: 40rpx;
}

.translation-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.translation-icon {
  font-size: 32rpx;
  color: #4CAF50;
  margin-right: 20rpx;
}

.translation-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #212121;
  display: block;
}

.translation-text {
  font-size: 26rpx;
  color: #616161;
  line-height: 1.6;
}

.footer {
  margin-top: 80rpx;
  text-align: center;
}

.footer-text {
  font-size: 22rpx;
  color: #9E9E9E;
}